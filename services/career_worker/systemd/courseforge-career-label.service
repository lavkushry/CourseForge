[Unit]
Description=CourseForge Career 24h Outcome Labeling Routine
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/CourseForge
Environment="PYTHONPATH=/home/ubuntu/CourseForge"
ExecStart=/home/ubuntu/Resume/.venv/bin/python3 -m services.career_worker.runner --action evaluate
StandardOutput=journal
StandardError=journal
