# Absolute paths recommended. Relative paths resolve from the repository root.
COURSES_DIR=./courses
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333
# Living Video Knowledge (dedicated collection; never reuse courseforge_chunks).
CF_QDRANT_COLLECTION=courseforge_living_video
CF_KNOWLEDGE_API_URL=http://127.0.0.1:8090
CF_KNOWLEDGE_WORKER_TOKEN=
CF_KNOWLEDGE_WORKER_ID=knowledge-worker-1
CF_KNOWLEDGE_ENABLE_QDRANT=0
CHAT_MODEL=qwen3:4b-instruct
EMBED_MODEL=qwen3-embedding:0.6b
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CF_WHISPER_MODEL=tiny
CF_OCR_ENGINE=tesseract
FRAME_INTERVAL_SECONDS=30
MAX_FRAMES_PER_VIDEO=180
# Set to 1 to skip video frame OCR when you only need audio.
DISABLE_FRAMES=0

# Vision captions preserve diagram/code content that OCR cannot interpret.
ENABLE_VISION=1
VISION_MODEL=gemma3:4b
VISION_REQUIRED=0
MAX_VISION_FRAMES_PER_VIDEO=30
# Sandbox runner is opt-in per submission, uses local Docker and no network.
LAB_IMAGE=courseforge-lab:local
LAB_SPARK_IMAGE=courseforge-lab-spark:local
# Optional dedicated kind cluster ONLY; never uses ~/.kube/config.
ENABLE_KIND_LABS=0

# Academy accounts: use your real HTTPS URL and SMTP configuration.
PUBLIC_BASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=1
# email: verify before learning; open: immediate student access; invite: private invitations.
# Open registration works without SMTP and does not verify email ownership.
REGISTRATION_MODE=email
# Only trust addresses belonging to your reverse proxy.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Selected provider: Brevo SMTP. Copy its SMTP key, not an API key.
SMTP_PROVIDER=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Unlisted Odysee embeds. Keep credentials only in this ignored file.
ODYSEE_AUTH_TOKEN=
ODYSEE_CHANNEL_ID=
DAILY_AI_QUOTA=30
DAILY_LAB_QUOTA=10
