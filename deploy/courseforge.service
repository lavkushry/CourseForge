[Unit]
Description=CourseForge academy API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/CourseForge
EnvironmentFile=/home/ubuntu/CourseForge/.env
ExecStart=/home/ubuntu/CourseForge/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --timeout-keep-alive 30
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
